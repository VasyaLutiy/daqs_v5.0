# LLM Provider Configuration
LLM_PROVIDER=gemini

# Gemini Configuration
GEMINI_API_KEY=api-key
GEMINI_MODEL=gemini-3-flash-preview

# Optional XAI / Grok Configuration
GROK_API_KEY=
GROK_MODEL=grok-4-1-fast-reasoning

# Public backend URL used by the React frontend.
# For local docker-compose keep localhost; for remote VPS set your public IP or domain.
NEXT_PUBLIC_API_BASE=http://localhost:8001

# Comma-separated list of browser origins allowed by FastAPI CORS middleware.
# Include your frontend origin, e.g. http://YOUR_VPS_PUBLIC_IP:3000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Dev-only: hosts allowed to access Next.js HMR resources.
# Example for LAN testing: localhost,127.0.0.1,192.168.1.145
NEXT_ALLOWED_DEV_ORIGINS=localhost,127.0.0.1,192.168.1.145
